<?xml version="1.0"?>
<launch>
  <!-- Same single-master control chain, with the existing reset pose at spawn.
       Avoid arm collapse before the effort controller starts under gravity. -->
  <include file="$(find husky_control)/launch/control.launch">
    <arg name="multimaster" value="false"/>
  </include>
  <include file="$(find husky_control)/launch/teleop.launch">
    <arg name="joystick" value="false"/>
  </include>
  <node name="spawn_husky_model" pkg="gazebo_ros" type="spawn_model"
    args="-x 0 -y 0 -z 0.2 -Y 0 -unpause -urdf -param robot_description
          -model husky_ur5 -robot_namespace /
          -J ur5_shoulder_pan_joint -0.01111974792726489
          -J ur5_shoulder_lift_joint -1.5705042627235626
          -J ur5_elbow_joint -0.0007863513851198434
          -J ur5_wrist_1_joint -1.5713908974689739
          -J ur5_wrist_2_joint -0.0005968816301642477
          -J ur5_wrist_3_joint -0.006540936480208259"/>
</launch>
